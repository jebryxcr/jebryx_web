# Desarrollo: proxy hacia EL MISMO JEBRYX_API. Sin /api/v1 al final.
VITE_API_PROXY_TARGET=http://localhost:8765
# Vacío utiliza /api/v1 en el mismo origen. En producción configura un reverse
# proxy /api hacia JEBRYX_API o indica su URL pública con CORS habilitado.
VITE_API_URL=
# Mismo cliente WEB de Google de la app; autoriza http://localhost:5173 en Google.
VITE_GOOGLE_WEB_CLIENT_ID=
# Modelos aceptados por config/app.php de JEBRYX_API.
VITE_COACH_SABIO_MODEL=openai/gpt-oss-120b
VITE_COACH_DESTELLO_MODEL=openai/gpt-oss-20b
