# Desarrollo: proxy hacia EL MISMO JEBRYX_API. Sin /api/v1 al final.
# API publicada. Para un backend local iniciado, usa http://127.0.0.1:8765.
VITE_API_PROXY_TARGET=https://jebryxapi-production.up.railway.app
# Vacío utiliza /api/v1 en el mismo origen. En Vercel, vercel.json ya reenvía
# /api a https://jebryxapi-production.up.railway.app (el mismo JEBRYX_API).
# Mantener vacío en Vercel para utilizar ese proxy y evitar CORS en el navegador.
VITE_API_URL=
# Mismo cliente WEB de Google de la app; autoriza http://localhost:5173 en Google.
VITE_GOOGLE_WEB_CLIENT_ID=
# Modelos aceptados por config/app.php de JEBRYX_API.
VITE_COACH_SABIO_MODEL=openai/gpt-oss-120b
VITE_COACH_DESTELLO_MODEL=openai/gpt-oss-20b
